<Window x:Class="WinLauncher.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border Style="{StaticResource DialogShellStyle}" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,20,22,20">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

            <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="InputBox" Style="{StaticResource DialogTextBoxStyle}" MaxLength="30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}"
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
