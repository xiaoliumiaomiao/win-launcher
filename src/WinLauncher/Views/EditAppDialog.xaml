<Window x:Class="WinLauncher.Views.EditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑应用"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border Style="{StaticResource DialogShellStyle}" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,20,22,20">
            <TextBlock Text="编辑应用" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource DialogTextBoxStyle}" MaxLength="60"/>

            <TextBlock Text="简介" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,5"/>
            <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogTextBoxStyle}" MaxLength="60"/>

            <Grid Margin="0,7,0,0">
                <Button Content="从程序信息自动填充" HorizontalAlignment="Left"
                        Height="26" Padding="10,0" FontSize="11.5" Cursor="Hand"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Background="Transparent" BorderThickness="0"
                        Click="OnAutoFill"
                        ToolTip="读取程序自带的版本描述信息，取不到时不会有变化"/>
                <TextBlock x:Name="CounterText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>

            <TextBlock x:Name="TargetText" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis" MaxHeight="32"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}"
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
